.npmrc
.pypirc
.git-credentials
credentials*
*credentials*.json
*secret*
*secrets*
!**/scripts/check-secrets.sh
*token*
!**/*tokens*.md
service-account*.json
.aws/
.gcloud/
.ssh/
.gnupg/
.kube/
.docker/config.json

# --- Claude Code machine state (never lives here; ~/.claude owns it) ----------
